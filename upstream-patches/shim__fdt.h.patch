--- a/shim/fdt.h
+++ b/shim/fdt.h
@@ -1,5 +1,55 @@
 #pragma once
 #include <stdint.h>
 
+#define FDT_MAX_BANKS	8
+#define FDT_MAX_RESERVED 64
+
+/* Structured memory map: /memory* banks and /reserved-memory children
+ * (with their no-map flag), for checking where the shim and its UFS DMA
+ * buffers live. Names are truncated to fit. */
+struct fdt_memmap {
+	struct {
+		uint64_t base, size;
+	} banks[FDT_MAX_BANKS];
+	unsigned n_banks;
+	struct {
+		uint64_t base, size;
+		unsigned no_map;
+		char name[20];
+	} reserved[FDT_MAX_RESERVED];
+	unsigned n_reserved;
+	unsigned n_reserved_dropped;	/* overflow beyond the table, counted */
+};
+
+/* Collect banks and reserved ranges - /memory* banks, /reserved-memory
+ * children (with their no-map flag), and the /memreserve/ block - for
+ * checking where the shim and its UFS DMA buffers live. Returns 1 on
+ * success, 0 on a malformed tree (including an unterminated or
+ * misaligned /memreserve/ block). Reserved entries beyond the table
+ * are dropped but counted in n_reserved_dropped (banks are dropped
+ * silently); never a walk failure for a mere overflow. */
+int fdt_collect_memmap(uintptr_t fdt, struct fdt_memmap *out);
+
 /* Read a u32/u64 (cell-size agnostic) property of /chosen. Returns 0 if absent. */
 int fdt_chosen_u64(uintptr_t fdt, const char *prop, uint64_t *out);
+int fdt_memory_contains(uintptr_t fdt, uint64_t base, uint64_t size);
+
+/* Ramoops node: a /reserved-memory child whose compatible contains
+ * "ramoops" or whose node name starts with "ramoops" (the GS101 rmem
+ * dtsi names it ramoops_mem@fd3ff000, compatible "ramoops"). Fields
+ * mirror what the Linux ramoops driver reads in ramoops_parse_dt()
+ * (fs/pstore/ram.c): absent optional properties read as 0. */
+struct fdt_ramoops {
+	uint64_t base, size;		/* first reg tuple (parent cells) */
+	uint32_t record_size, console_size, ftrace_size, pmsg_size;
+	uint32_t ecc_size, mem_type;
+	int found;			/* qualified node with a decoded reg */
+	int qualified_no_reg;		/* qualified node seen without a usable reg */
+};
+
+/* Returns 1 when a qualified node with reg was found. */
+int fdt_ramoops(uintptr_t fdt, struct fdt_ramoops *out);
+
+struct fdt_video { uint64_t base, size; uint32_t width, height, stride; };
+int fdt_framebuffer(uintptr_t fdt, struct fdt_video *video);
+void fdt_probe_report(uintptr_t fdt);
