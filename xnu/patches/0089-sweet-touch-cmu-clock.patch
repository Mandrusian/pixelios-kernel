+/* Optional: without the cmu-* properties the driver still runs, it just cannot dump or touch the CMU. */
+static void
+tg_parse_cmu(DTEntry node)
+{
+	static const struct { const char *name; uint32_t *p; } props[] = {
+		{ "cmu-option", &tg.cmu.option }, { "cmu-mux-usi", &tg.cmu.mux_usi },
+		{ "cmu-mux-bus", &tg.cmu.mux_bus }, { "cmu-mux-bus-auto", &tg.cmu.mux_bus_auto },
+		{ "cmu-mux-usi-auto", &tg.cmu.mux_usi_auto }, { "cmu-div", &tg.cmu.div },
+		{ "cmu-gate-ipclk", &tg.cmu.gate_ipclk }, { "cmu-gate-pclk", &tg.cmu.gate_pclk },
+		{ "cmu-gate-rstn", &tg.cmu.gate_rstn }, { "cmu-qch", &tg.cmu.qch },
+		{ "cmu-mux-sel-bit", &tg.cmu.sel_bit }, { "cmu-mux-busy-bit", &tg.cmu.busy_bit },
+		{ "cmu-gate-manual-bit", &tg.cmu.manual_bit }, { "cmu-gate-val-bit", &tg.cmu.val_bit },
+		{ "cmu-gate-auto-bit", &tg.cmu.auto_bit }, { "cmu-qch-enable-bit", &tg.cmu.qch_en_bit },
+		{ "cmu-qch-req-bit", &tg.cmu.qch_req_bit },
+	};
+	uint64_t reg[2];
+
+	if (!tg_dt_u64(node, "cmu-reg", reg, 2)) {
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(props) / sizeof(props[0]); i++) {
+		if (!tg_dt_u32(node, props[i].name, props[i].p, 1) || *props[i].p >= (i < 10 ? reg[1] : 32u)) {
+			return;
+		}
+	}
+	tg.cmu.base = reg[0];
+	tg.cmu.size = reg[1];
+	tg.cmu.ok = true;
+}
+
+/* ---- CMU_PERIC1 clock chain of USI11 (docs/research/19) ---- */
+
+static uint32_t
+tg_cmu_rd(uint32_t off)
+{
+	return tg_rd(tg.cmu.va, off);
+}
+
+/* Reads only. Printed in every run, before the first write of any kind. */
+static void
+tg_cmu_dump(void)
+{
+	if (!tg.cmu.ok) {
+		printf("SWEET TOUCH: cmu: no usable cmu-* properties, clock registers not read\n");
+		return;
+	}
+	printf("SWEET TOUCH: cmu base %#llx: OPTION[%#x]=%#x usi_mux[%#x]=%#x bus_mux[%#x]=%#x bus_auto[%#x]=%#x "
+	    "usi_auto[%#x]=%#x div[%#x]=%#x\n", (unsigned long long)tg.cmu.base,
+	    tg.cmu.option, tg_cmu_rd(tg.cmu.option), tg.cmu.mux_usi, tg_cmu_rd(tg.cmu.mux_usi),
+	    tg.cmu.mux_bus, tg_cmu_rd(tg.cmu.mux_bus), tg.cmu.mux_bus_auto, tg_cmu_rd(tg.cmu.mux_bus_auto),
+	    tg.cmu.mux_usi_auto, tg_cmu_rd(tg.cmu.mux_usi_auto), tg.cmu.div, tg_cmu_rd(tg.cmu.div));
+	printf("SWEET TOUCH: cmu gates: ipclk_4[%#x]=%#x pclk_4[%#x]=%#x rstnsync[%#x]=%#x QCH[%#x]=%#x\n",
+	    tg.cmu.gate_ipclk, tg_cmu_rd(tg.cmu.gate_ipclk), tg.cmu.gate_pclk, tg_cmu_rd(tg.cmu.gate_pclk),
+	    tg.cmu.gate_rstn, tg_cmu_rd(tg.cmu.gate_rstn), tg.cmu.qch, tg_cmu_rd(tg.cmu.qch));
+}
+
+/* Write val to reg, read back, print before/after. The bits in check must read back as in val. */
+static bool
+tg_cmu_write_check(const char *what, uint32_t off, uint32_t val, uint32_t check)
+{
+	uint32_t before = tg_cmu_rd(off), after;
+
+	tg_wr(tg.cmu.va, off, val);
+	after = tg_cmu_rd(off);
+	printf("SWEET TOUCH: cmu %s [%#x]: %#x -> wrote %#x -> %#x\n", what, off, before, val, after);
+	if ((after & check) != (val & check)) {
+		printf("SWEET TOUCH: cmu %s: read-back mismatch (mask %#x), clock sequence aborted\n", what, check);
+		return false;
+	}
+	return true;
+}
+
+/* Step 3/4/5: manual gate open = MANUAL 1, CG_VAL 1, automatic gating 0. */
+static bool
+tg_cmu_gate(const char *what, uint32_t off)
+{
+	uint32_t m = 1u << tg.cmu.manual_bit, v = 1u << tg.cmu.val_bit, a = 1u << tg.cmu.auto_bit;
+	uint32_t val = (tg_cmu_rd(off) | m | v) & ~a;
+
+	return tg_cmu_write_check(what, off, val, m | v | a);
+}
+
+/* sweettouchclk >= 1: docs/research/19 section 6 steps 1,3,4,5 (and 6 for 2). Returns false if aborted. */
+static bool
+tg_cmu_enable(void)
+{
+	uint32_t sel = 1u << tg.cmu.sel_bit, busy = 1u << tg.cmu.busy_bit, v;
+	uint64_t t0;
+
+	if (!tg.cmu.ok || tg.clk_mode < 1) {
+		return true;
+	}
+	v = tg_cmu_rd(tg.cmu.mux_usi);
+	printf("SWEET TOUCH: cmu: sweettouchclk=%d, forcing the USI11 clock chain\n", tg.clk_mode);
+	if (v & sel) {
+		printf("SWEET TOUCH: cmu usi mux [%#x] = %#x: already selects the TOP source, not written\n",
+		    tg.cmu.mux_usi, v);
+	} else {
+		if (!tg_cmu_write_check("usi mux", tg.cmu.mux_usi, v | sel, sel)) {
+			return false;
+		}
+		t0 = tg_now_us();
+		while ((tg_cmu_rd(tg.cmu.mux_usi) & busy) && tg_now_us() - t0 < 1000u) {
+		}
+		if (tg_cmu_rd(tg.cmu.mux_usi) & busy) {
+			printf("SWEET TOUCH: cmu usi mux still BUSY after 1 ms, clock sequence aborted\n");
+			return false;
+		}
+	}
+	if (!tg_cmu_gate("ipclk_4 gate", tg.cmu.gate_ipclk) || !tg_cmu_gate("pclk_4 gate", tg.cmu.gate_pclk) ||
+	    !tg_cmu_gate("rstnsync gate", tg.cmu.gate_rstn)) {
+		return false;
+	}
+	if (tg.clk_mode >= 2) {
+		uint32_t q = (1u << tg.cmu.qch_en_bit) | (1u << tg.cmu.qch_req_bit);
+		if (!tg_cmu_write_check("QCH", tg.cmu.qch, tg_cmu_rd(tg.cmu.qch) | q, q)) {
+			return false;
+		}
+	}
+	printf("SWEET TOUCH: cmu: clock sequence done\n");
+	return true;
+}
