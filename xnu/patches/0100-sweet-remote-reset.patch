+/* sweetremote=1: block on a UDP socket, reset on the magic payload (see the header). */
+static void
+sweet_remote_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	static char buf[32];
+	socket_t so = NULL;
+	struct sockaddr_in sin;
+
+	bzero(&sin, sizeof(sin));
+	sin.sin_len = sizeof(sin);
+	sin.sin_family = AF_INET;
+	sin.sin_port = htons(5141);
+	delay_for_interval(20 * 1000, 1000 * 1000);      /* let the network stack come up first */
+	while (so == NULL) {
+		if (sock_socket(PF_INET, SOCK_DGRAM, IPPROTO_UDP, NULL, NULL, &so) != 0 ||
+		    sock_bind(so, (struct sockaddr *)&sin) != 0) {
+			if (so != NULL) {
+				sock_close(so);
+				so = NULL;
+			}
+			delay_for_interval(1000, 1000 * 1000);   /* 1 s; the stack may not be up yet */
+		}
+	}
+	printf("SWEET RESTART: remote reset listening on udp/5141\n");
+	for (;;) {
+		struct iovec iov = { .iov_base = buf, .iov_len = sizeof(buf) - 1 };
+		struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+		size_t got = 0;
+		if (sock_receive(so, &msg, 0, &got) != 0) {
+			delay_for_interval(100, 1000 * 1000);
+			continue;
+		}
+		buf[got] = 0;
+		if (strcmp(buf, "SWEET-RESET-BL") == 0) {
+			printf("SWEET RESTART: remote reset to bootloader\n");
+			sweet_machine_reset(1);
+		} else if (strcmp(buf, "SWEET-RESET") == 0) {
+			printf("SWEET RESTART: remote restart\n");
+			sweet_machine_reset(0);
+		}
+	}
+}
