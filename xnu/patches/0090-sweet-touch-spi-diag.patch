+/* Variants A..E (sweettouchvar=1, header comment). Returns true when the 5-byte burst of the chip-id read completed. */
+static bool
+tg_variant(unsigned n)
+{
+	uint8_t cmd[5];
+	uint32_t v;
+	int err;
+
+	switch (n) {
+	case 0:   /* A */
+		v = tg_rd(tg.spi, SPI_CLK_CFG);
+		tg_wr(tg.spi, SPI_CLK_CFG, (v & ~CLK_PSR_MASK) | 3u | CLK_ENCLK);
+		break;
+	case 2:   /* C */
+		tg_wr(tg.usi, USI_CON, tg_rd(tg.usi, USI_CON) & ~USI_CON_RESET);
+		delay(1);
+		v = tg_rd(tg.usi, USI_OPTION);
+		tg_wr(tg.usi, USI_OPTION, (v & ~USI_OPT_CLKSTOP) | USI_OPT_CLKREQ);
+		break;
+	case 3:   /* D */
+		tg_wr(tg.usi, USI_CON, tg_rd(tg.usi, USI_CON) | USI_CON_RESET);
+		delay(1);
+		tg_wr(tg.usi, USI_CON, tg_rd(tg.usi, USI_CON) & ~USI_CON_RESET);
+		delay(1);
+		v = tg_rd(tg.usi_mode, 0);
+		tg_wr(tg.usi_mode, 0, (v & ~tg.usi_mode_mask) | tg.usi_mode_spi);
+		break;
+	case 4:   /* E: engine-driven chip select */
+		tg_wr(tg.spi, SPI_CS_REG, CS_AUTO | CS_NSC_CNT_2);
+		tg_pin_set_func(&tg.cs, tg.spi_func);
+		tg_pin_report("cs(E)", &tg.cs);
+		break;
+	default:  /* B: nothing but the order in the burst */
+		break;
+	}
+	tg_spi_engine_init();   /* the engine reset of tg_spi_setup, after the USI/clock change (a USI reset clears it) */
+	cmd[0] = 0;
+	(void)ftm5_hwreg_read_cmd(cmd, FTM5_ADDR_DCHIP_ID);
+	if (n != 4) {
+		tg_pin_put(&tg.cs, 0);
+		delay(1);
+	}
+	tg.last_st = tg.last_ch = 0;
+	err = tg_spi_burst_ex(cmd, NULL, sizeof(cmd), n == 1);
+	delay(FTM5_SPI_DELAY_CS_US);
+	tg_pin_put(&tg.cs, 1);
+	if (n == 4) {   /* back to the GPIO chip select of tg_xfer */
+		tg_pin_set_func(&tg.cs, PIN_FUNC_OUTPUT);
+	}
+	delay(2);
+	printf("SWEET TOUCH: VARIANT %c: %s, status=%#x ch=%#x (at timeout: status=%#x ch=%#x) clk=%#x\n", (char)('A' + n),
+	    err ? "timeout" : "completed", tg_rd(tg.spi, SPI_STATUS), tg_rd(tg.spi, SPI_CH_CFG), tg.last_st, tg.last_ch,
+	    tg_rd(tg.spi, SPI_CLK_CFG));
+	return err == 0;
+}
