+
+/* Phase 4C: Raven USB2 PHY wake guard, adapted from the working
+ * shim/usbgadget.c RAVEN_PHY_WAKE_V5 implementation. Probe-only.
+ * Keep the command logic unchanged; restore exactly the PHY suspend/LPM
+ * bits present before the command, including timeout/error paths. */
+static int
+ud_epcmd(unsigned ep, uint32_t cmd, uint32_t p0, uint32_t p1, uint32_t p2)
+{
+	if (!ud.gs101 || !px.enabled) {
+		return ud_epcmd_raw(ep, cmd, p0, p1, p2);
+	}
+	uint32_t phy = dwc_rd(GUSB2PHYCFG0);
+	uint32_t saved = phy & GUSB2PHYCFG_PM_MASK;
+	if (saved != 0) {
+		dwc_wr(GUSB2PHYCFG0, phy & ~GUSB2PHYCFG_PM_MASK);
+	}
+	if (ep == 0 && (cmd & 0xffu) == DEPCMD_DEPSTARTCFG) {
+		printf("SWEET USBPX: PHY guard cfg=0x%08x cleared=0x%08x\n",
+		    phy, phy & ~GUSB2PHYCFG_PM_MASK);
+	}
+	int result = ud_epcmd_raw(ep, cmd, p0, p1, p2);
+	if (saved != 0) {
+		uint32_t current = dwc_rd(GUSB2PHYCFG0);
+		dwc_wr(GUSB2PHYCFG0, current | saved);
+	}
+	return result;
 }
 
