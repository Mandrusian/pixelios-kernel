+/*
+ * Pixel 6a (gs101). tools/mkadt.py adds /sweet-usb (compatible
+ * google,gs101-dwusb3) on bluejay only: reg = the DWC3 core (0x11110000),
+ * dma-pool-range = the "abl" reserved DRAM range. ABL leaves the DWC_usb31
+ * powered, in device role and halted (RUN_STOP=0, DALEPENA=3) with an event
+ * buffer of its own inside that range (GEVNTADR moves between boots), and
+ * the shim does not touch it on the --boot-xnu path; shim/usbgadget.c
+ * enumerates the same controller from exactly that state, so the same
+ * register sequence is used here and its DMA page is taken from the same
+ * place (shim/usbpool.c). sweetusb=2 starts the gadget as on sweet.
+ * Boot-arg sweetusbdma=1 instead takes the DMA area from the kernel's own
+ * RAM (kmem_alloc_contig, cacheable, ud_sync as on sweet): an experiment to
+ * learn whether the controller can DMA into the 0x88... bank (unknown).
+ * Returns false when there is no gs101 node (sweet takes the path above).
+ */
+#define GS101_COMPAT            "google,gs101-dwusb3"
+#define GS101_COMPAT_LEN        19
+#define GSNPSID                 0xc120
+#define GSNPSID_IP_USB31        0x3331  /* GSNPSID[31:16], observed 0x33313130 on bluejay */
+#define GCTL_PRTCAP(v)          (((v) >> 12) & 3)
+#define GCTL_PRTCAP_DEVICE      2
+#define DWC3_REGS_MIN           0xd000  /* up to the DEPCMD blocks of the endpoints used (0xc85c) */
+
+static bool
+sweet_usb_probe_gs101(int mode)
+{
+	DTEntry node;
+	char const *compat = NULL;
+	uintptr_t const *reg = NULL, *range = NULL;
+	unsigned int csize = 0, rsize = 0, psize = 0;
+	int dmamode = 0;
+	uint64_t pool_pa = 0;
+
+	if (SecureDTLookupEntry(NULL, "/sweet-usb", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "compatible", (void const **)&compat, &csize) != kSuccess ||
+	    compat == NULL || csize <= GS101_COMPAT_LEN || strncmp(compat, GS101_COMPAT, GS101_COMPAT_LEN) != 0) {
+		return false;
+	}
+	ud.gs101 = true;
+	if (SecureDTGetProperty(node, "reg", (void const **)&reg, &rsize) != kSuccess ||
+	    rsize < 2 * sizeof(uintptr_t) || reg[1] < DWC3_REGS_MIN) {
+		printf("SWEET USB: gs101: /sweet-usb has no usable reg\n");
+		return true;
+	}
+	vm_offset_t dwc = ml_io_map(reg[0], reg[1]);
+	if (dwc == 0) {
+		printf("SWEET USB: DWC3 map failed\n");
+		return true;
+	}
+	usb_dump_dwc3(dwc);
+	/* Read-only identity checks before anything is written (shim/usbgadget.c refuses the same way). */
+	uint32_t id = usb_rd(dwc, GSNPSID), gctl = usb_rd(dwc, 0xc110);
+	if ((id >> 16) != GSNPSID_IP_USB31) {
+		printf("SWEET USB: gs101: unexpected GSNPSID 0x%08x, not touching the controller\n", id);
+		return true;
+	}
+	if (GCTL_PRTCAP(gctl) != GCTL_PRTCAP_DEVICE) {
+		printf("SWEET USB: gs101: core not in device role (GCTL 0x%08x)\n", gctl);
+		return true;
+	}
+	if (mode < 2) {
+		return true;
+	}
+	PE_parse_boot_argn("sweetusbdma", &dmamode, sizeof(dmamode));
+	if (dmamode != 1) {
+		if (SecureDTGetProperty(node, "dma-pool-range", (void const **)&range, &psize) != kSuccess ||
+		    psize < 2 * sizeof(uintptr_t)) {
+			printf("SWEET USB: gs101: /sweet-usb has no dma-pool-range\n");
+			return true;
+		}
+		uint64_t gev = ((uint64_t)usb_rd(dwc, 0xc404) << 32) | usb_rd(dwc, 0xc400);
+		uint64_t pool = gev & ~(uint64_t)0xfff;         /* shim/usbpool.c: the 4 KiB page of GEVNTADR */
+		/* io_map maps whole kernel pages: those, not just the pool, must lie inside the ABL range. */
+		uint64_t map_lo = pool & ~(uint64_t)PAGE_MASK;
+		uint64_t map_hi = (pool + UD_SIZE + PAGE_MASK) & ~(uint64_t)PAGE_MASK;
+		if (gev == 0 || map_lo < range[0] || map_hi < map_lo || map_hi > range[0] + range[1]) {
+			printf("SWEET USB: gs101: GEVNTADR 0x%llx not inside the abl range 0x%llx+0x%llx, no DMA pool\n",
+			    gev, (unsigned long long)range[0], (unsigned long long)range[1]);
+			return true;
+		}
+		pool_pa = pool;
+	}
+	printf("SWEET USB: gs101: DMA from %s\n", pool_pa ? "ABL's pool page" : "kernel RAM (sweetusbdma=1)");
+	sweet_usb_gadget_start(dwc, pool_pa);
+	return true;
+}
