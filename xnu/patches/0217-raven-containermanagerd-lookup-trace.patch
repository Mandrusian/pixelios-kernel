--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -330,4 +330,24 @@
+static int
+sweet_trace_lookup(kauth_cred_t cred __unused, struct vnode *dvp,
+    struct label *dlabel __unused, struct componentname *cnp)
+{
+	static int sweet_lk_n;
+	char pn[32];
+	proc_name(proc_selfpid(), pn, sizeof(pn));
+	if (sweet_lk_n < 2500 && !strncmp(pn, "containermanager", 16)) {
+		char dp[120];
+		int dl = sizeof(dp);
+		sweet_lk_n++;
+		if (vn_getpath(dvp, dp, &dl) != 0) {
+			dp[0] = 0;
+		}
+		printf("SWEET LOOKUP %s %s / %.*s\n", pn, dp, (int)cnp->cn_namelen, cnp->cn_nameptr);
+	}
+	return 0;
+}
+
 static const struct mac_policy_ops sweet_sandbox_mac_ops = {
 	.mpo_policy_syscall = sweet_sandbox_syscall,
 	.mpo_priv_grant = sweet_sandbox_priv_grant,
+	.mpo_vnode_check_lookup = sweet_trace_lookup,
 };
