--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -330,4 +330,27 @@
+static int
+sweet_trace_open(kauth_cred_t cred __unused, struct vnode *vp,
+    struct label *label __unused, int acc_mode __unused)
+{
+	static int sweet_op_n;
+	char pn[32];
+	proc_name(proc_selfpid(), pn, sizeof(pn));
+	if (vp != NULL && sweet_op_n < 3500 && proc_selfpid() >= 28 && proc_selfpid() <= 60) {
+		char *pb = (char *)kalloc_data(256, Z_WAITOK | Z_ZERO);
+		if (pb != NULL) {
+			int pl = 256;
+			sweet_op_n++;
+			if (vn_getpath(vp, pb, &pl) != 0) {
+				pb[0] = 0;
+			}
+			printf("SWEET OPEN %d %s %s\n", proc_selfpid(), pn, pb);
+			kfree_data(pb, 256);
+		}
+	}
+	return 0;
+}
+
 static const struct mac_policy_ops sweet_sandbox_mac_ops = {
 	.mpo_policy_syscall = sweet_sandbox_syscall,
 	.mpo_priv_grant = sweet_sandbox_priv_grant,
+	.mpo_vnode_check_open = sweet_trace_open,
 };
