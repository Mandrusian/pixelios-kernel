+#include "sweet_usbblk_proto.h"
+static uint32_t px_u32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+        ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+static uint64_t px_u64(const uint8_t *p)
+{
+    return (uint64_t)px_u32(p) | ((uint64_t)px_u32(p + 4) << 32);
+}
+static void px_put32(uint8_t *p, uint32_t n)
+{
+    for (unsigned i = 0; i < 4; ++i) p[i] = (uint8_t)(n >> (i * 8));
+}
+static void px_put64(uint8_t *p, uint64_t n)
+{
+    px_put32(p, (uint32_t)n);
+    px_put32(p + 4, (uint32_t)(n >> 32));
+}
+uint32_t px_crc32(const uint8_t *p, size_t n)
+{
+    uint32_t crc = 0xffffffffu;
+    for (size_t i = 0; i < n; i++) {
+        crc ^= p[i];
+        for (unsigned b = 0; b < 8; b++)
+            crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1u)));
+    }
+    return ~crc;
+}
+uint64_t px_lba(uint32_t seq)
+{
+    if (seq == 0 || seq > PX_TEST_READS) return UINT64_MAX;
+    return (((uint64_t)(seq - 1) * 977u) + 293u) % PX_SECTORS;
+}
+void px_request(uint8_t out[PX_REQUEST_BYTES], uint32_t seq)
+{
+    out[0] = 'P'; out[1] = 'X'; out[2] = 'B'; out[3] = 'Q';
+    px_put32(out + 4, seq);
+    px_put64(out + 8, px_lba(seq));
+    px_put32(out + 16, PX_BLOCK_BYTES);
+    px_put32(out + 20, 0);
+}
+int px_response_check(const uint8_t *p, size_t n, uint32_t seq)
+{
+    if (!p || n != PX_RESPONSE_BYTES || !seq || seq > PX_TEST_READS) return -1;
+    if (p[0] != 'P' || p[1] != 'X' || p[2] != 'B' || p[3] != 'R') return -2;
+    uint64_t lba = px_lba(seq);
+    if (px_u32(p + 4) != seq || px_u64(p + 8) != lba ||
+        px_u32(p + 16) != PX_BLOCK_BYTES) return -3;
+    if (px_u32(p + 20) != px_crc32(p + 24, PX_BLOCK_BYTES)) return -4;
+    for (unsigned i = 0; i < PX_BLOCK_BYTES; i++)
+        if (p[24 + i] != (uint8_t)(((i * 37u + (unsigned)lba * 17u) ^ 0xa5u) & 255u))
+            return -5;
+    return 0;
+}
