+/* Consume only the test EtherType; leave ordinary ECM/IP traffic untouched. */
+static bool
+ud_px_rx(const uint8_t *frame, uint32_t length)
+{
+	if (!px.enabled || length < 14u) return false;
+	if (frame[12] != (PX_ETHERTYPE >> 8) || frame[13] != (PX_ETHERTYPE & 255u))
+		return false;
+	if (length != PX_ETH_FRAME || !px.awaiting || px.finished ||
+	    memcmp(frame, ud_phone_mac, 6) != 0 ||
+	    memcmp(frame + 6, px_host_mac, 6) != 0) {
+		printf("SWEET USBPX: ignored malformed/unexpected block frame length=%u\n", length);
+		return true;
+	}
+	uint32_t seq = px.verified + 1u;
+	int result = px_response_check(frame + 14, length - 14, seq);
+	if (result != 0) {
+		printf("SWEET USBPX: REJECT seq=%u reason=%d\n", seq, result);
+		return true;
+	}
+	px.verified++;
+	px.awaiting = false;
+	px.retries = 0;
+	printf("SWEET USBPX: verified %u/%u lba=%llu\n", px.verified,
+	    PX_TEST_READS, px_lba(seq));
+	if (px.verified == PX_TEST_READS) {
+		px.finished = true;
+		printf("SWEET USBPX: PASS blocks=8 bytes=4096\n");
+	}
+	return true;
+}
