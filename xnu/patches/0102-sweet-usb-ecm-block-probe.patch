+#define SWEET_USBBLK_PROTO_H
+#include <stddef.h>
+#include <stdint.h>
+#define PX_BLOCK_BYTES 512u
+#define PX_RESPONSE_BYTES 536u
+#define PX_REQUEST_BYTES 24u
+#define PX_SECTORS 4096u
+#define PX_TEST_READS 8u
+uint32_t px_crc32(const uint8_t *p, size_t n);
+uint64_t px_lba(uint32_t seq);
+void px_request(uint8_t out[PX_REQUEST_BYTES], uint32_t seq);
+int px_response_check(const uint8_t *data, size_t length, uint32_t seq);
+#endif
