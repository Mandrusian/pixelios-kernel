+/* Enqueue one raw ECM Ethernet frame without involving the BSD IP stack. */
+static bool
+ud_px_send(uint32_t seq)
+{
+	uint8_t frame[14 + PX_REQUEST_BYTES];
+	memcpy(frame, px_host_mac, 6);
+	memcpy(frame + 6, ud_phone_mac, 6);
+	frame[12] = (uint8_t)(PX_ETHERTYPE >> 8);
+	frame[13] = (uint8_t)PX_ETHERTYPE;
+	px_request(frame + 14, seq);
+	mbuf_t m = NULL;
+	if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0) return false;
+	if (mbuf_maxlen(m) < sizeof(frame)) {
+		mbuf_freem(m);
+		return false;
+	}
+	memcpy(mbuf_data(m), frame, sizeof(frame));
+	mbuf_setlen(m, sizeof(frame));
+	mbuf_pkthdr_setlen(m, sizeof(frame));
+	lck_mtx_lock(ud.lock);
+	if (ud.txq_count == UD_TXQ || !ud.configured) {
+		lck_mtx_unlock(ud.lock);
+		mbuf_freem(m);
+		return false;
+	}
+	ud.txq[(ud.txq_head + ud.txq_count) % UD_TXQ] = m;
+	ud.txq_count++;
+	ud_tx_kick_locked();
+	lck_mtx_unlock(ud.lock);
+	return true;
+}
+
+static void
+ud_px_tick(uint32_t tick)
+{
+	if (!px.enabled || px.finished || !ud.configured || ud.data_alt != 1 || ud.lock == NULL)
+		return;
+	if (px.awaiting && (uint32_t)(tick - px.started) < 3000u) return;
+	if (px.awaiting && px.retries >= 3u) {
+		px.finished = true;
+		printf("SWEET USBPX: FAIL timeout seq=%u\n", px.verified + 1u);
+		return;
+	}
+	uint32_t seq = px.verified + 1u;
+	if (px.verified >= PX_TEST_READS) return;
+	if (ud_px_send(seq)) {
+		px.awaiting = true;
+		px.started = tick;
+		px.retries++;
+		printf("SWEET USBPX: READ seq=%u lba=%llu try=%u\n",
+		    seq, px_lba(seq), px.retries);
+	}
+}
