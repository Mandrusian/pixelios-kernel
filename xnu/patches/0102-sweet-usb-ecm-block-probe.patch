+/* Read-only USB-ECM block probe. Opt-in sweetusbblk=1, gs101 only. */
+#define PX_ETHERTYPE 0x88B5u
+#define PX_ETH_FRAME (14u + PX_RESPONSE_BYTES)
+static const uint8_t px_host_mac[6] = { 0x02, 0x00, 0x5e, 0x77, 0xee, 0x01 };
+static struct {
+	bool enabled;
+	bool awaiting;
+	bool finished;
+	uint32_t verified;
