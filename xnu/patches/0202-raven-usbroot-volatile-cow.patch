+#define UR_COW_BUCKETS 4096u
+#define UR_COW_MAX_PAGES 32768u
+struct ur_cow_page {
+    struct ur_cow_page *next;
+    uint64_t page;
+    uint8_t mask;
+    uint8_t bytes[4096];
+};
+static struct ur_cow_page *ur_cow_table[UR_COW_BUCKETS];
+static uint32_t ur_cow_pages;
+static uint64_t ur_cow_sectors_written;
+static struct ur_cow_page *
+ur_cow_find(uint64_t page)
+{
+    uint32_t bucket=(uint32_t)((page^(page>>12))&(UR_COW_BUCKETS-1));
+    for(struct ur_cow_page *p=ur_cow_table[bucket];p;p=p->next)
+        if(p->page==page)return p;
+    return NULL;
+}
+static int
+ur_cow_write(uint64_t sector,const uint8_t *src)
+{
+    uint64_t page=sector/8u;
+    uint32_t bucket=(uint32_t)((page^(page>>12))&(UR_COW_BUCKETS-1));
+    struct ur_cow_page *p=ur_cow_find(page);
+    if(!p){
+        if(ur_cow_pages>=UR_COW_MAX_PAGES)return ENOSPC;
+        p=kalloc_data(sizeof(*p),Z_WAITOK);
+        if(!p)return ENOMEM;
+        p->page=page;
+        p->mask=0;
+        p->next=ur_cow_table[bucket];
+        ur_cow_table[bucket]=p;
+        ur_cow_pages++;
+    }
+    uint32_t slot=(uint32_t)(sector&7u);
+    memcpy(p->bytes+512u*slot,src,512u);
+    p->mask|=(uint8_t)(1u<<slot);
+    ur_cow_sectors_written++;
+    if(ur_cow_sectors_written<=16 ||
+       (ur_cow_sectors_written&(ur_cow_sectors_written-1))==0)
+        printf("SWEET COW: volatile sector=%llu pages=%u writes=%llu\n",
+            (unsigned long long)sector,ur_cow_pages,
+            (unsigned long long)ur_cow_sectors_written);
+    return 0;
+}
+static void
+ur_cow_merge(uint64_t sector,uint8_t *dest)
+{
+    struct ur_cow_page *p=ur_cow_find(sector/8u);
+    uint32_t slot=(uint32_t)(sector&7u);
+    if(p && (p->mask&(1u<<slot)))memcpy(dest,p->bytes+512u*slot,512u);
+}
