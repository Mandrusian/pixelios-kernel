From: PixeliOS <noreply@example.invalid>
Subject: [PATCH] sweet: gs101 touch ABL-exact transfer (sweettouchcs=1)

Observed working in the shim probe run touch1 (docs/HANDOFF.md session 12): rails on + oscillator clock + ABL spi_xfer + reset pulse before the identify gave 36 48.

---
diff --git a/bsd/dev/sweet_touch_gs101.c b/bsd/dev/sweet_touch_gs101.c
--- a/bsd/dev/sweet_touch_gs101.c
+++ b/bsd/dev/sweet_touch_gs101.c
@@ -9,6 +9,11 @@
  *   sweettouch=0|1|2     0 off; 1 identify only (phase 1); 2 identify, then enable and poll (phase 2, default)
  *   sweettouchdelay=S    seconds to wait before the first register access (default 45): a bus hang then
  *                        happens after the GUI and the persistent log got there first
+ *   sweettouchcs=1       ABL-exact transfer (patch 0095, observed to work in the shim probe run touch1, docs/HANDOFF.md session 12):
+ *                        USI_CON reset + USI_OPTION CLKREQ + FB_CLK instead of the engine init, CS_REG &= ~1 around each transaction,
+ *                        the ABL's burst (no MODE_CFG/INT_EN/SWAP_CFG writes), PUD := 0 on the five pads, and the reset pulse +
+ *                        controller-ready wait BEFORE the identify. Needs the rails on (shim --touch-probe=rails) and the oscillator
+ *                        clock: sweettouchpoke="m:10c00640=0=10;d:100;m:10c0180c=5=f;" (USI mux bit4 := 0, divider := 5).
  *   sweettouchmux=1      drive the AP/AOC mux (TS_SPI_SEL) low = AP if the AP is not already driving it low
  *   sweettouchclk=0|1|2  0 (default) only READ the CMU_PERIC1 clock registers (always printed, "SWEET TOUCH: cmu");
  *                        1 also force the USI11 clock chain (docs/research/19 section 6 steps 1,3,4,5: user mux,
@@ -157,7 +162,8 @@
 		uint32_t mux, div, gate, gate_bit;
 		vm_offset_t va;
 	} top;
-	int clk_mode, var;
+	int clk_mode, var, cs_abl;
+	bool reset_done;   /* tg_reset_and_ready already ran (sweettouchcs=1 does it before the identify) */
 	char poke[POKE_MAX_LEN + 16];   /* sweettouchpoke boot-arg (empty = none) */
 	uint32_t last_st, last_ch;   /* STATUS / CH_CFG at the last burst timeout */
 	int mode, mux_force;
@@ -248,6 +254,13 @@
 }
 
 static void
+tg_pin_set_pud(const struct tg_pin *p, uint32_t pud)
+{
+	uint32_t sh = p->pin * 4u, v = tg_rd(p->va, PIN_PUD);
+	tg_wr(p->va, PIN_PUD, (v & ~(0xfu << sh)) | ((pud & 0xfu) << sh));
+}
+
+static void
 tg_pin_report(const char *name, const struct tg_pin *p)
 {
 	printf("SWEET TOUCH: pin %-5s bank %#llx[%u] func=%#x dat=%d pud=%#x\n", name,
@@ -322,10 +335,59 @@
 	return 0;
 }
 
+/* sweettouchcs=1: the ABL's spi_xfer chunk (docs/research/21 section 1.2, ABL 0xc5e4-0xc6ec), the same sequence as
+ * shim/touchprobe.c abl_burst (observed working, run touch1): no MODE_CFG / INT_EN / SWAP_CFG writes. PACKET_CNT = n | EN, TX bytes,
+ * CH_CFG |= TX|RX, poll RX level >= n, read RX, poll TX level 0, CH_CFG &= ~(TX|RX), PACKET_CNT = 0, SW_RST pulse + drain. */
+static int
+tg_abl_burst(const uint8_t *tx, uint8_t *rx, unsigned len)
+{
+	uint64_t t0;
+	unsigned i;
+	int err = 0;
+
+	if (len == 0 || len > SPI_FIFO_BYTES) {
+		return -1;
+	}
+	tg_wr(tg.spi, SPI_CH_CFG, tg_rd(tg.spi, SPI_CH_CFG) & ~CH_SW_RST);
+	tg_wr(tg.spi, SPI_PACKET_CNT, len | PKT_CNT_EN);
+	for (i = 0; i < len; i++) {
+		tg_wr(tg.spi, SPI_TX_DATA, tx ? tx[i] : 0u);
+	}
+	tg_wr(tg.spi, SPI_CH_CFG, tg_rd(tg.spi, SPI_CH_CFG) | CH_RXCH_ON | CH_TXCH_ON);
+	t0 = tg_now_us();
+	while (ST_RX_LVL(tg_rd(tg.spi, SPI_STATUS)) < len) {
+		if (tg_now_us() - t0 > 20000u) {
+			tg.last_st = tg_rd(tg.spi, SPI_STATUS);
+			tg.last_ch = tg_rd(tg.spi, SPI_CH_CFG);
+			err = -1;
+			break;
+		}
+	}
+	if (!err) {
+		for (i = 0; i < len; i++) {
+			uint32_t d = tg_rd(tg.spi, SPI_RX_DATA);
+			if (rx) {
+				rx[i] = (uint8_t)d;
+			}
+		}
+		t0 = tg_now_us();
+		while (ST_TX_LVL(tg_rd(tg.spi, SPI_STATUS)) && tg_now_us() - t0 < 1000u) {
+		}
+	}
+	tg_wr(tg.spi, SPI_CH_CFG, tg_rd(tg.spi, SPI_CH_CFG) & ~(CH_RXCH_ON | CH_TXCH_ON));
+	tg_wr(tg.spi, SPI_PACKET_CNT, 0);
+	tg_wr(tg.spi, SPI_CH_CFG, tg_rd(tg.spi, SPI_CH_CFG) | CH_SW_RST);
+	t0 = tg_now_us();
+	while (ST_RX_LVL(tg_rd(tg.spi, SPI_STATUS)) && tg_now_us() - t0 < 1000u) {
+		(void)tg_rd(tg.spi, SPI_RX_DATA);
+	}
+	return err;
+}
+
 static int
 tg_spi_burst(const uint8_t *tx, uint8_t *rx, unsigned len)
 {
-	return tg_spi_burst_ex(tx, rx, len, false);
+	return tg.cs_abl ? tg_abl_burst(tx, rx, len) : tg_spi_burst_ex(tx, rx, len, false);
 }
 
