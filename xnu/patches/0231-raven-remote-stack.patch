--- a/bsd/dev/sweet_restart.c
+++ b/bsd/dev/sweet_restart.c
@@ -21,3 +21,4 @@
 #include <sys/proc_internal.h>
 #include <sys/signalvar.h>
+#include <kern/task.h>
 #include <stdint.h>
@@ -100,4 +101,7 @@
 static char sweet_kill_target[MAXCOMLEN * 2 + 1];
+static int sweet_kill_stack;
+extern task_t proc_task(proc_t);
+extern void sweet_sample_task(const char *name, int pid, task_t task);
 static int
 sweet_kill_cb(proc_t p, void *arg __unused)
 {
@@ -106,6 +110,10 @@
 	proc_name(proc_pid(p), nm, sizeof(nm));
 	if (strcmp(nm, sweet_kill_target) == 0) {
