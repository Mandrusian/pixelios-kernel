@@ -133,3 +141,8 @@
 			strlcpy(sweet_kill_target, buf + 11, sizeof(sweet_kill_target));
 			proc_iterate(PROC_ALLPROCLIST, sweet_kill_cb, NULL, NULL, NULL);
+		} else if (strncmp(buf, "SWEET-STACK ", 12) == 0) {
+			strlcpy(sweet_kill_target, buf + 12, sizeof(sweet_kill_target));
+			sweet_kill_stack = 1;
+			proc_iterate(PROC_ALLPROCLIST, sweet_kill_cb, NULL, NULL, NULL);
+			sweet_kill_stack = 0;
 		}
