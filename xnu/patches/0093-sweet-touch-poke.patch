+/* ---- runtime pokes (patch 0093; grammar and limits in sweet_touch_poke.h) ---- */
+
+static void
+tg_poke_run(void)
+{
+	static const char *const why[] = { "", "script too long", "syntax error or missing final ';'", "too many ops (max 32)",
+		"address not 4-aligned", "address outside the allow-list", "delay above 1000000 us",
+		"write to a read-only CMU range outside the driver's own registers" };
+	struct poke_hw hw = {
+		.spi_pa = tg.spi_pa, .spi_size = tg.spi_size, .usi_mode_pa = tg.usi_mode_pa,
+		.cmu_ok = tg.cmu.ok, .top_ok = tg.top.ok, .cmu_base = tg.cmu.base, .cmu_size = tg.cmu.size,
+		.top_base = tg.top.base, .top_size = tg.top.size,
+		.cmu_mux_usi = tg.cmu.mux_usi, .cmu_mux_bus = tg.cmu.mux_bus, .cmu_mux_bus_auto = tg.cmu.mux_bus_auto,
+		.cmu_mux_usi_auto = tg.cmu.mux_usi_auto, .cmu_gate_ipclk = tg.cmu.gate_ipclk,
+		.cmu_gate_pclk = tg.cmu.gate_pclk, .cmu_gate_rstn = tg.cmu.gate_rstn, .cmu_qch = tg.cmu.qch, .cmu_div = tg.cmu.div,
+		.top_mux = tg.top.mux, .top_div = tg.top.div, .top_gate = tg.top.gate,
+		.pin_bank = { tg.clk.bank_pa, tg.mosi.bank_pa, tg.miso.bank_pa, tg.cs.bank_pa, tg.irq.bank_pa,
+			tg.reset.bank_pa, tg.mux.bank_pa },
+	};
+	struct poke_range rg[POKE_MAX_RANGES];
+	uint64_t wins[POKE_MAX_WINDOWS];
+	vm_offset_t va[POKE_MAX_RANGES] = { 0 };
+	struct poke_op ops[POKE_MAX_OPS];
+	unsigned bad, nrg, nwin;
+	int n;
+
+	if (!tg.poke[0]) {
+		return;
+	}
+	nrg = poke_build(&hw, rg, wins, &nwin);
+	n = poke_parse(tg.poke, ops, rg, nrg, wins, nwin, &bad);
+	if (n < 0) {
+		printf("SWEET TOUCH: poke: rejected (%s, op %u), nothing run\n", why[-n], bad);
+		return;
+	}
+	printf("SWEET TOUCH: poke: %d ops\n", n);
+	for (int i = 0; i < n; i++) {
+		const struct poke_op *o = &ops[i];
+		int k;
+		vm_offset_t p;
+		uint32_t before, nv;
+		bool in_spi;
+
+		if (o->kind == 'd') {
+			printf("SWEET TOUCH: poke %d d: %u us\n", i, o->val);
+			if (o->val >= 2000u) {
+				tg_sleep_ms(o->val / 1000u);
+			} else {
+				delay(o->val);
+			}
+			continue;
+		}
+		k = poke_find(rg, nrg, o->addr);   /* poke_parse guarantees a match */
+		in_spi = k == 0;
+		if (!va[k] && !(va[k] = tg_map(rg[k].base, rg[k].size))) {
+			printf("SWEET TOUCH: poke %d: mapping %#llx failed, op skipped\n", i, (unsigned long long)rg[k].base);
+			continue;
+		}
+		p = va[k] + (vm_offset_t)(o->addr - rg[k].base);
+		if (o->kind == 'r') {
+			printf("SWEET TOUCH: poke %d r %#llx = %#x\n", i, (unsigned long long)o->addr, tg_rd(p, 0));
+			continue;
+		}
+		if (o->kind == 'w') {   /* no read before the write: SPI RX_DATA and friends pop on read */
+			tg_wr(p, 0, o->val);
+			if (in_spi) {
+				printf("SWEET TOUCH: poke %d w %#llx: wrote %#x (SPI11: no read-back, reads can have side effects)\n", i,
+				    (unsigned long long)o->addr, o->val);
+			} else {
+				printf("SWEET TOUCH: poke %d w %#llx: wrote %#x -> read back %#x\n", i, (unsigned long long)o->addr,
+				    o->val, tg_rd(p, 0));
+			}
+			continue;
+		}
+		before = tg_rd(p, 0);   /* m needs the old value */
+		nv = (before & ~o->mask) | (o->val & o->mask);
+		tg_wr(p, 0, nv);
+		if (in_spi) {
+			printf("SWEET TOUCH: poke %d m %#llx mask %#x: %#x -> wrote %#x (SPI11: no read-back)\n", i,
+			    (unsigned long long)o->addr, o->mask, before, nv);
+		} else {
+			printf("SWEET TOUCH: poke %d m %#llx mask %#x: %#x -> wrote %#x -> read back %#x\n", i,
+			    (unsigned long long)o->addr, o->mask, before, nv, tg_rd(p, 0));
+		}
+	}
+}
