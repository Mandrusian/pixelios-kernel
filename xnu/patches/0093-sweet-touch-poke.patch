diff --git a/bsd/dev/sweet_touch_poke.h b/bsd/dev/sweet_touch_poke.h
new file mode 100644
index 0000000..e1dd63d
--- /dev/null
+++ b/bsd/dev/sweet_touch_poke.h
@@ -0,0 +1,209 @@
+/*
+ * Pure parser and allow-list for the touch driver's runtime MMIO poke script (boot-arg sweettouchpoke=, xnu patch 0093).
+ * No kernel dependencies, so shim/touchpoke_host_test.c compiles the very same bytes on the host.
+ *
+ * Script = ';'-terminated ops (EVERY op ends with ';', so a script cut short by the boot-args limit is a syntax error),
+ * all hex (optional 0x prefix), no spaces (a space ends a boot-arg):
+ *   r:ADDR;            read 32 bits
+ *   w:ADDR=VAL;        write
+ *   m:ADDR=MASK=VAL;   read-modify-write: new = (old & ~MASK) | (VAL & MASK)
+ *   d:US;              delay, 0..1000000 microseconds
+ * ADDR is a physical address, 4-aligned, and [ADDR, ADDR+4) must lie inside one allow-list range. Ranges flagged ro
+ * (CMU_PERIC1, CMU_TOP) accept w/m only on the 4-byte windows the ADT names (the registers the driver itself writes).
+ */
+#ifndef SWEET_TOUCH_POKE_H
+#define SWEET_TOUCH_POKE_H
+#include <stdint.h>
+
+#define POKE_MAX_OPS      32u
+#define POKE_MAX_LEN      240u       /* script characters; boot-args total is 607 (BOOT_LINE_LENGTH 608) */
+#define POKE_MAX_DELAY_US 1000000u
+#define POKE_MAX_RANGES   16u
+#define POKE_MAX_WINDOWS  16u
+
+struct poke_op {
+	char kind;           /* 'r' 'w' 'm' 'd' */
+	uint64_t addr;       /* unused for 'd' */
+	uint32_t mask, val;  /* 'd': val = microseconds */
+};
+
+struct poke_range {
+	uint64_t base, size;   /* size 0 = absent, never matches */
+	int ro;                /* 1: reads only, except the words listed in the window table */
+};
+
+/* Index of the range holding [addr, addr+4), or -1. */
+static inline int
+poke_find(const struct poke_range *rg, unsigned nrg, uint64_t addr)
+{
+	for (unsigned i = 0; i < nrg; i++) {
+		if (rg[i].size >= 4 && addr >= rg[i].base && addr - rg[i].base <= rg[i].size - 4u) {
+			return (int)i;
+		}
+	}
+	return -1;
+}
+
+/* Input for poke_build: what the driver learned from the ADT (the cmu_* / top_* offsets are the DT properties). */
+struct poke_hw {
+	uint64_t spi_pa, spi_size, usi_mode_pa;
+	int cmu_ok, top_ok;
+	uint64_t cmu_base, cmu_size, top_base, top_size;
+	uint32_t cmu_mux_usi, cmu_mux_bus, cmu_mux_bus_auto, cmu_mux_usi_auto, cmu_gate_ipclk, cmu_gate_pclk, cmu_gate_rstn,
+	    cmu_qch, cmu_div;                 /* CMU_PERIC1 offsets writable by poke (docs/research/21 writes DIV; never OPTION) */
+	uint32_t top_mux, top_div, top_gate;  /* CMU_TOP offsets */
+	uint64_t pin_bank[7];                 /* clk mosi miso cs irq reset mux */
+};
+
+/* Range table: 0 SPI11 (rw; the real size is 0x1000, soc.json usi11_spi_size), 1 USI11 sysreg page (rw; the page size
+ * 0x1000 is a GUESS: only the mode register at usi_mode_pa is in the ADT), 2 CMU_PERIC1 (ro), 3 CMU_TOP (ro), 4..10 the
+ * pin banks (0x20 each, rw). wins[] = absolute addresses of the writable words in the ro ranges. */
+static inline unsigned
+poke_build(const struct poke_hw *h, struct poke_range *rg, uint64_t *wins, unsigned *nwin)
+{
+	uint32_t c[9] = { h->cmu_mux_usi, h->cmu_mux_bus, h->cmu_mux_bus_auto, h->cmu_mux_usi_auto, h->cmu_gate_ipclk,
+		h->cmu_gate_pclk, h->cmu_gate_rstn, h->cmu_qch, h->cmu_div };
+	uint32_t t[3] = { h->top_mux, h->top_div, h->top_gate };
+
+	*nwin = 0;
+	rg[0].base = h->spi_pa;
+	rg[0].size = h->spi_size;
+	rg[0].ro = 0;
+	rg[1].base = h->usi_mode_pa & ~(uint64_t)0xfff;
+	rg[1].size = 0x1000;   /* GUESS: page size of the sysreg block */
+	rg[1].ro = 0;
+	rg[2].base = h->cmu_base;
+	rg[2].size = h->cmu_ok ? h->cmu_size : 0;
+	rg[2].ro = 1;
+	rg[3].base = h->top_base;
+	rg[3].size = h->top_ok ? h->top_size : 0;
+	rg[3].ro = 1;
+	for (unsigned i = 0; i < 7; i++) {
+		rg[4 + i].base = h->pin_bank[i];
+		rg[4 + i].size = 0x20;
+		rg[4 + i].ro = 0;
+	}
+	for (unsigned i = 0; rg[2].size && i < 9; i++) {
+		if (!(c[i] & 3u) && c[i] <= rg[2].size - 4u) {
+			wins[(*nwin)++] = rg[2].base + c[i];
+		}
+	}
+	for (unsigned i = 0; rg[3].size && i < 3; i++) {
+		if (!(t[i] & 3u) && t[i] <= rg[3].size - 4u) {
+			wins[(*nwin)++] = rg[3].base + t[i];
+		}
+	}
+	return 11;
+}
+
+/* Returns the number of ops (>= 0), or a negative error:
+ * -1 too long, -2 syntax (incl. missing final ';'), -3 too many ops, -4 address unaligned, -5 address outside the
+ * allow-list, -6 delay too big, -7 write to a read-only range outside the windows.
+ * *bad = index of the offending op (0-based) for the caller's single message. */
+static inline int
+poke_parse(const char *s, struct poke_op *ops, const struct poke_range *rg, unsigned nrg,
+    const uint64_t *wins, unsigned nwin, unsigned *bad)
+{
+	unsigned n = 0, len = 0;
+
+	*bad = 0;
+	while (s[len]) {
+		if (++len > POKE_MAX_LEN) {
+			return -1;
+		}
+	}
+	while (*s) {
+		struct poke_op *o;
+		uint64_t v[3];
+		unsigned nv = 0, want;
+
+		*bad = n;
+		if (n == POKE_MAX_OPS) {
+			return -3;
+		}
+		o = &ops[n];
+		o->kind = *s;
+		want = *s == 'r' ? 1 : *s == 'w' ? 2 : *s == 'm' ? 3 : *s == 'd' ? 1 : 0;
+		if (!want || s[1] != ':') {
+			return -2;
+		}
+		s += 2;
+		for (;;) {   /* hex fields separated by '=' */
+			uint64_t x = 0;
+			unsigned digits = 0;
+
+			if (s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) {
+				s += 2;
+			}
+			for (;; s++, digits++) {
+				int c = *s, d;
+				if (c >= '0' && c <= '9') {
+					d = c - '0';
+				} else if (c >= 'a' && c <= 'f') {
+					d = c - 'a' + 10;
+				} else if (c >= 'A' && c <= 'F') {
+					d = c - 'A' + 10;
+				} else {
+					break;
+				}
+				if (digits >= 16) {
+					return -2;
+				}
+				x = x << 4 | (uint64_t)d;
+			}
+			if (!digits || nv == 3) {
+				return -2;
+			}
+			v[nv++] = x;
+			if (*s != '=') {
+				break;
+			}
+			s++;
+		}
+		if (nv != want || *s != ';') {
+			return -2;
+		}
+		s++;
+		o->addr = 0;
+		o->mask = 0xffffffffu;
+		o->val = 0;
+		if (o->kind == 'd') {
+			if (v[0] > POKE_MAX_DELAY_US) {
+				return -6;
+			}
+			o->val = (uint32_t)v[0];
+		} else {
+			int k;
+
+			o->addr = v[0];
+			if (want > 1 && (v[1] > 0xffffffffu || (want == 3 && v[2] > 0xffffffffu))) {
+				return -2;
+			}
+			if (o->kind == 'w') {
+				o->val = (uint32_t)v[1];
+			} else if (o->kind == 'm') {
+				o->mask = (uint32_t)v[1];
+				o->val = (uint32_t)v[2];
+			}
+			if (o->addr & 3u) {
+				return -4;
+			}
+			k = poke_find(rg, nrg, o->addr);
+			if (k < 0) {
+				return -5;
+			}
+			if (o->kind != 'r' && rg[k].ro) {
+				unsigned j;
+				for (j = 0; j < nwin && wins[j] != o->addr; j++) {
+				}
+				if (j == nwin) {
+					return -7;
+				}
+			}
+		}
+		n++;
+	}
+	return (int)n;
+}
+
+#endif
