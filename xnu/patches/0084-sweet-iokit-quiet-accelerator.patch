+/*
+ * The GPU's service class as QuartzCore looks for it: CAMetalContextCreate polls IOServiceMatching("IOAcceleratorES")
+ * 300 times, 100 ms apart, in every process that sets up CA rendering (30 s per backboardd start). One without
+ * MetalPluginName is found and then passed over by Metal, so the renderers stay as they were. Boot-arg sweetaccel=0
+ * leaves it out. Idea from the ios-topaz / ios-sailfish forks (topaz 0138, sailfish 0166).
+ */
+class IOAcceleratorES : public IOService {
+	OSDeclareDefaultStructors(IOAcceleratorES);
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
