+/* Up to UR_WIN 1 KiB chunks outstanding at once; hides the per-request round trip. */
+int sweet_usbroot_read_win(uint64_t lba,uint32_t nsect,uint8_t *dest);
+int sweet_usbroot_read_win(uint64_t lba,uint32_t nsect,uint8_t *dest)
+{
+    uint32_t nch=(nsect+1)/2;
+    if(!dest || !nsect || nch>UR_WIN)return EINVAL;
+    if(!ur.enabled || !ud.gs101 || ud.lock==NULL)return ENXIO;
+    uint64_t deadline;
+    clock_interval_to_deadline(30000,NSEC_PER_MSEC,&deadline);
+    while ((!ud.configured || ud.data_alt!=1) && mach_absolute_time()<deadline)
+        ud_sleep_ms(5);
+    if (!ud.configured || ud.data_alt!=1)return ETIMEDOUT;
+    for(uint32_t k=0;k<nch;k++){
+        urw.lba[k]=lba+2ull*k;
+        urw.cnt[k]=(k==nch-1 && (nsect&1u))?512u:1024u;
+        urw.done[k]=false;
+    }
+    __asm__ volatile ("dmb ish" ::: "memory");
+    urw.n=nch;
+    for(unsigned retry=0;retry<4;retry++){
+        for(uint32_t k=0;k<nch;k++){
+            if(urw.done[k])continue;
+            uint32_t seq=++ur_next_seq;
+            if(!seq)seq=++ur_next_seq;
+            urw.seq[k]=seq;
+            (void)ud_ur_send(seq,urw.lba[k],urw.cnt[k],UR_OP_READ);
+        }
+        clock_interval_to_deadline(1500,NSEC_PER_MSEC,&deadline);
+        for(;;){
+            bool all=true;
+            for(uint32_t k=0;k<nch;k++)if(!urw.done[k])all=false;
+            if(all || mach_absolute_time()>=deadline)break;
+            uint64_t poll;clock_interval_to_deadline(100,NSEC_PER_USEC,&poll);
+            (void)assert_wait_deadline(&ud.sleep_chan,THREAD_UNINT,poll);
+            thread_block(THREAD_CONTINUE_NULL);
+        }
+        bool all=true;
+        for(uint32_t k=0;k<nch;k++)if(!urw.done[k])all=false;
+        if(all){
+            __asm__ volatile ("dmb ish" ::: "memory");
+            urw.n=0;
+            for(uint32_t k=0;k<nch;k++)memcpy(dest+1024u*k,urw.data[k],urw.cnt[k]);
+            return 0;
+        }
+    }
+    urw.n=0;
+    printf("SWEET USBROOT: window timeout lba=%llu nsect=%u\n", lba, nsect);
+    return ETIMEDOUT;
+}
