+/*
+ * Read-only clock estimate (no register writes): 8 dependent adds per iteration retire at one add per cycle on
+ * Cortex-A55/A76/X1 [guess: 1 cycle ALU latency], so MHz = adds * CNTFRQ / ticks. The bootloader leaves the
+ * CPU clocks at an unknown state and XNU has no cpufreq driver. Runs with IRQs masked, ~10 ms per CPU.
+ */
+static void
+sweet_cpu_clock_probe(unsigned int cpu)
+{
+	const uint64_t iters = 1000000, adds = iters * 8;
+	uint64_t ticks = 0, frq = __builtin_arm_rsr64("CNTFRQ_EL0");
+
+	for (int pass = 0; pass < 2; pass++) {
+		uint64_t x = 0, n = iters;
+		__builtin_arm_isb(0xf);
+		uint64_t t0 = __builtin_arm_rsr64("CNTVCT_EL0");
+		__asm__ volatile (
+			"1:\n\t"
+			"add %0, %0, #1\n\tadd %0, %0, #1\n\tadd %0, %0, #1\n\tadd %0, %0, #1\n\t"
+			"add %0, %0, #1\n\tadd %0, %0, #1\n\tadd %0, %0, #1\n\tadd %0, %0, #1\n\t"
+			"subs %1, %1, #1\n\tb.ne 1b"
+			: "+r"(x), "+r"(n) : : "cc");
+		__builtin_arm_isb(0xf);
+		ticks = __builtin_arm_rsr64("CNTVCT_EL0") - t0;
+	}
+	if (cpu < SWEET_SMP_MAX_CPUS) {   /* IOLog is not safe at splsched: startAll prints it */
+		sweet_clk_ticks[cpu] = ticks;
+		sweet_clk_midr[cpu] = __builtin_arm_rsr64("MIDR_EL1") & 0xffffffffULL;
+	}
+	sweet_clk_frq = frq;
+	sweet_clk_adds = adds;
+}
