+/* PixelIOS host-backed read-only disk protocol v1, standard C11, no XNU ABI. */
+#ifndef SWEET_USBROOT_PROTO_H
+#define SWEET_USBROOT_PROTO_H
+#include <stddef.h>
+#include <stdint.h>
+#define UR_SECTOR_BYTES 512u
+#define UR_MAX_READ_BYTES 1024u
+#define UR_REQ_BYTES 32u
+#define UR_RESP_HEADER_BYTES 32u
+#define UR_MAX_RESP_BYTES (UR_RESP_HEADER_BYTES+UR_MAX_READ_BYTES)
+#define UR_CAP_BYTES 8u
+#define UR_OP_READ 1u
+#define UR_OP_CAP 2u
+/* Negative outcomes never modify output. */
+uint32_t ur_crc32(const uint8_t *p, size_t n);
+int ur_make_request(uint8_t out[UR_REQ_BYTES], uint32_t seq, uint64_t lba,
+    uint32_t length, uint32_t op);
+int ur_check_reply(const uint8_t *p, size_t n, uint32_t seq, uint64_t lba,
+    uint32_t length, uint8_t *out);
+uint64_t ur_u64(const uint8_t *p);
+#endif
