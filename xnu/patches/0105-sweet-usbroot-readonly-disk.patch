+/* Called only by the serialized BSD disk strategy or root initialization.
+ * Each request has its own seq: late replies cannot satisfy newer reads. */
+static int
+ur_exchange(uint64_t lba,uint32_t count,uint32_t op,uint8_t *out)
+{
+    if (!ur.enabled || !ud.gs101 || ud.lock==NULL)return ENXIO;
+    if (op==UR_OP_READ && (count!=512 && count!=1024))return EINVAL;
+    if (op==UR_OP_CAP && (lba!=0 || count!=0))return EINVAL;
+    uint64_t deadline;
+    clock_interval_to_deadline(30000,NSEC_PER_MSEC,&deadline);
+    while ((!ud.configured || ud.data_alt!=1) && mach_absolute_time()<deadline)
+        ud_sleep_ms(5);
+    if (!ud.configured || ud.data_alt!=1)return ETIMEDOUT;
+    for (unsigned retry=0;retry<4;retry++) {
+        uint32_t seq=++ur_next_seq;
+        if (!seq)seq=++ur_next_seq;
+        ur.seq=seq;ur.lba=lba;ur.count=count;
+        ur.done=false;ur.pending=true;
+        __asm__ volatile ("dmb ish" ::: "memory");
+        if (!ud_ur_send(seq,lba,count,op)) {
+            ur.pending=false;
+            ud_sleep_ms(5);
+            continue;
+        }
+        clock_interval_to_deadline(3000,NSEC_PER_MSEC,&deadline);
+        while (!ur.done && mach_absolute_time()<deadline)ud_sleep_ms(5);
+        __asm__ volatile ("dmb ish" ::: "memory");
+        if(ur.done){
+            if(out && count)memcpy(out,ur.data,count);
+            return 0;
+        }
+        ur.pending=false;
+    }
+    printf("SWEET USBROOT: transport timeout lba=%llu count=%u\n", lba, count);
+    return ETIMEDOUT;
+}
+
+int sweet_usbroot_capacity(uint64_t *sectors);
+int sweet_usbroot_capacity(uint64_t *sectors)
+{
+    int e=ur_exchange(0,0,UR_OP_CAP,NULL);
+    if(!e && sectors)*sectors=ur.capacity;
+    return e;
+}
+
+int sweet_usbroot_read_sectors(uint64_t lba,uint32_t nsect,uint8_t *dest);
+int sweet_usbroot_read_sectors(uint64_t lba,uint32_t nsect,uint8_t *dest)
+{
+    if(!dest || !(nsect==1 || nsect==2))return EINVAL;
+    return ur_exchange(lba,nsect*UR_SECTOR_BYTES,UR_OP_READ,dest);
+}
