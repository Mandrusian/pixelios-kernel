+/* A small bounded raw Ethernet frame goes through the established TX queue.
+ * Never bypass the endpoint lock or touch controller registers from BSD I/O. */
+static bool
+ud_ur_send(uint32_t seq, uint64_t lba, uint32_t len, uint32_t op)
+{
+    uint8_t frame[14+UR_REQ_BYTES];
+    memcpy(frame,px_host_mac,6);
+    memcpy(frame+6,ud_phone_mac,6);
+    frame[12]=(uint8_t)(UR_ETHERTYPE>>8);
+    frame[13]=(uint8_t)UR_ETHERTYPE;
+    if (ur_make_request(frame+14,seq,lba,len,op))return false;
+    mbuf_t m=NULL;
+    if (mbuf_gethdr(MBUF_DONTWAIT,MBUF_TYPE_DATA,&m)!=0)return false;
+    if (mbuf_maxlen(m)<sizeof(frame)){mbuf_freem(m);return false;}
+    memcpy(mbuf_data(m),frame,sizeof(frame));
+    mbuf_setlen(m,sizeof(frame));
+    mbuf_pkthdr_setlen(m,sizeof(frame));
+    lck_mtx_lock(ud.lock);
+    if(ud.txq_count==UD_TXQ || !ud.configured || ud.data_alt!=1){
+        lck_mtx_unlock(ud.lock);mbuf_freem(m);return false;
+    }
+    ud.txq[(ud.txq_head+ud.txq_count)%UD_TXQ]=m;
+    ud.txq_count++;
+    ud_tx_kick_locked();
+    lck_mtx_unlock(ud.lock);
+    return true;
+}
