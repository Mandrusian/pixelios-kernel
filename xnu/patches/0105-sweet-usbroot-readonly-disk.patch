+#include "sweet_usbroot_proto.h"
+static uint32_t u32(const uint8_t *p) {
+    return (uint32_t)p[0] | ((uint32_t)p[1]<<8) |
+        ((uint32_t)p[2]<<16) | ((uint32_t)p[3]<<24);
+}
+uint64_t ur_u64(const uint8_t *p) {
+    return (uint64_t)u32(p) | ((uint64_t)u32(p+4)<<32);
+}
+static void put32(uint8_t *p, uint32_t v) {
+    p[0]=(uint8_t)v; p[1]=(uint8_t)(v>>8);
+    p[2]=(uint8_t)(v>>16); p[3]=(uint8_t)(v>>24);
+}
+static void put64(uint8_t *p, uint64_t v) {
+    put32(p, (uint32_t)v);put32(p+4,(uint32_t)(v>>32));
+}
+uint32_t ur_crc32(const uint8_t *p, size_t n) {
+    uint32_t crc=0xffffffffu;
+    for(size_t i=0;i<n;i++) {
+        crc^=p[i];
+        for(unsigned b=0;b<8;b++) {
+            uint32_t mask=0u-(crc&1u);
+            crc=(crc>>1) ^ (0xedb88320u & mask);
+        }
+    }
+    return ~crc;
+}
+int ur_make_request(uint8_t out[UR_REQ_BYTES], uint32_t seq, uint64_t lba,
+                    uint32_t length, uint32_t op) {
+    if(!out || !seq ||
+       (op==UR_OP_CAP ? (length!=0 || lba!=0) :
+        (op!=UR_OP_READ || !(length==512 || length==1024) ||
+         lba > UINT64_MAX-(length/512u)))) return -1;
+    for(unsigned i=0;i<UR_REQ_BYTES;i++)out[i]=0;
+    out[0]='R';out[1]='5';out[2]='Q';out[3]='1';
+    put32(out+4,seq);put64(out+8,lba);put32(out+16,length);put32(out+20,op);
+    return 0;
+}
+int ur_check_reply(const uint8_t *p, size_t n, uint32_t seq, uint64_t lba,
+                   uint32_t length, uint8_t *out) {
+    if(!p || !out || !seq || !(length==512 || length==1024 || length==8) ||
+       n!=(size_t)UR_RESP_HEADER_BYTES+length) return -1;
+    if(p[0]!='R' || p[1]!='5' || p[2]!='R' || p[3]!='1')return -2;
+    if(u32(p+4)!=seq || ur_u64(p+8)!=lba || u32(p+16)!=length)return -3;
+    if(u32(p+20)!=0 || u32(p+28)!=0)return -4;
+    if(u32(p+24)!=ur_crc32(p+UR_RESP_HEADER_BYTES,length))return -5;
+    /* Validate all fields and CRC before copying any output. */
+    for(unsigned i=0;i<length;i++)out[i]=p[UR_RESP_HEADER_BYTES+i];
+    return 0;
+}
