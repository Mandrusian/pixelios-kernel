+/*
+ * PixelIOS host-backed read-only BSD disk. No MMIO, UFS probes, physical
+ * partition reads, or writes. Root on rd=usbroot0 with sweetusbroot=1 and a
+ * Raven ADT generated with --no-ufs. All sector I/O goes to Fedora via ECM.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+#include "sweet_usbroot_proto.h"
+
+extern void sweet_usb_probe(void);
+extern int sweet_usbroot_capacity(uint64_t *sectors);
+extern int sweet_usbroot_read_sectors(uint64_t lba, uint32_t nsect, uint8_t *dst);
+
+static struct {
+    uint64_t sectors;
+    uint32_t secsize;
+    int bmajor, cmajor;
+    dev_t bdev;
+    bool ready;
+} urdisk;
+static LCK_GRP_DECLARE(ur_disk_grp, "sweet_usbroot");
+static LCK_MTX_DECLARE(ur_disk_lock, &ur_disk_grp);
+
+static int disk_open(__unused dev_t d, int flags,
+                     __unused int typ, __unused struct proc *p) {
+    if (!urdisk.ready)return ENXIO;
+    return (flags & FWRITE) ? EROFS : 0;
+}
+static int disk_close(__unused dev_t d, __unused int flags,
+                      __unused int typ, __unused struct proc *p) {return 0;}
+static void disk_strategy(buf_t bp) {
+    uint32_t count=buf_count(bp);
+    uint64_t blk;
+    caddr_t va=NULL;
+    int err=0;
+    uint32_t done=0;
+    buf_setresid(bp,count);
+    if (!(buf_flags(bp)&B_READ)) {err=EROFS;goto finish;}
+    if (!urdisk.ready || (int64_t)buf_blkno(bp)<0 ||
+        !urdisk.secsize || (count%UR_SECTOR_BYTES)) {err=EINVAL;goto finish;}
+    if ((uint64_t)buf_blkno(bp)>UINT64_MAX/urdisk.secsize) {err=EINVAL;goto finish;}
+    blk=(uint64_t)buf_blkno(bp)*(urdisk.secsize/UR_SECTOR_BYTES);
+    if (blk>urdisk.sectors || (uint64_t)(count/UR_SECTOR_BYTES)>urdisk.sectors-blk) {
+        err=EINVAL;goto finish;
+    }
+    if (!count)goto finish;
+    if (buf_map(bp,&va)) {err=EIO;goto finish;}
+    lck_mtx_lock(&ur_disk_lock);
+    while (done<count) {
+        uint8_t data[UR_MAX_READ_BYTES];
+        uint32_t bytes=MIN(count-done,UR_MAX_READ_BYTES);
+        uint32_t sectors=bytes/UR_SECTOR_BYTES;
+        err=sweet_usbroot_read_sectors(blk+done/UR_SECTOR_BYTES,sectors,data);
+        if (err)break;
+        memcpy(va+done,data,bytes);
+        done+=bytes;
+        buf_setresid(bp,count-done);
+    }
+    lck_mtx_unlock(&ur_disk_lock);
+    buf_unmap(bp);
+finish:
+    if(err)buf_seterror(bp,err);
+    buf_biodone(bp);
+}
+static int disk_ioctl(__unused dev_t dev,u_long cmd,caddr_t data,
+                      __unused int flags,__unused struct proc *p,int chr) {
+    uint32_t *u=(uint32_t *)data;
+    uint64_t *q=(uint64_t *)data;
+    switch(cmd) {
+    case DKIOCGETBLOCKSIZE: *u=urdisk.secsize;return 0;
+    case DKIOCSETBLOCKSIZE:
+        if(chr || (*u!=512 && *u!=1024 && *u!=2048 && *u!=4096))return EINVAL;
+        urdisk.secsize=*u;return 0;
+    case DKIOCGETPHYSICALBLOCKSIZE:*u=512;return 0;
+    case DKIOCGETBLOCKCOUNT:*q=urdisk.sectors/(urdisk.secsize/512);return 0;
+    case DKIOCISWRITABLE:*u=0;return 0;
+    case DKIOCSYNCHRONIZE:
+    case DKIOCSYNCHRONIZECACHE:return 0; /* Read-only, nothing to flush. */
+    case DKIOCGETMAXBLOCKCOUNTREAD:*q=UR_MAX_READ_BYTES/urdisk.secsize;
+        if(!*q)*q=1;return 0;
+    case DKIOCGETMAXBLOCKCOUNTWRITE:*q=0;return 0;
+    case DKIOCGETMAXSEGMENTCOUNTREAD:
+    case DKIOCGETMAXSEGMENTCOUNTWRITE:*q=1;return 0;
+    default:return ENOTTY;
+    }
+}
+static int disk_bioctl(dev_t d,u_long c,caddr_t a,int f,struct proc *p) {
+    return disk_ioctl(d,c,a,f,p,0);
+}
+static int disk_cioctl(dev_t d,u_long c,caddr_t a,int f,struct proc *p) {
+    return disk_ioctl(d,c,a,f,p,1);
+}
+static int disk_psize(__unused dev_t d) {
+    if (!urdisk.ready)return -1;
+    return (int)MIN(urdisk.sectors/(urdisk.secsize/512),(uint64_t)INT_MAX);
+}
+static int disk_read(dev_t dev, struct uio *uio,__unused int flags) {
+    return physio(disk_strategy,NULL,dev,B_READ,minphys,uio,(int)urdisk.secsize);
+}
+static int disk_write(__unused dev_t d,__unused struct uio *u,__unused int f) {
+    return EROFS;
+}
+static const struct bdevsw ur_bdevsw={
+    .d_open=disk_open,.d_close=disk_close,.d_strategy=disk_strategy,
+    .d_ioctl=disk_bioctl,.d_dump=eno_dump,.d_psize=disk_psize,.d_type=D_DISK
+};
+static const struct cdevsw ur_cdevsw={
+    .d_open=disk_open,.d_close=disk_close,.d_read=disk_read,.d_write=disk_write,
+    .d_ioctl=disk_cioctl,.d_stop=eno_stop,.d_reset=eno_reset,.d_ttys=NULL,
+    .d_select=eno_select,.d_mmap=eno_mmap,.d_strategy=eno_strat,
+    .d_reserved_1=eno_getc,.d_reserved_2=eno_putc,.d_type=D_DISK
+};
+
+int sweet_usbroot_rootdev(dev_t *dev);
+int sweet_usbroot_rootdev(dev_t *dev) {
+    int enabled=0;
+    DTEntry node;
+    uint64_t sectors=0;
+    int err;
+    if (urdisk.ready){*dev=urdisk.bdev;return 0;}
+    PE_parse_boot_argn("sweetusbroot",&enabled,sizeof(enabled));
+    if (enabled!=1) return ENXIO;
+    /* If the ADT declares internal UFS, refuse: the test must stay isolated. */
+    if (SecureDTLookupEntry(NULL,"/sweet-ufs",&node)==kSuccess) {
+        printf("SWEET USBROOT: refusing ADT containing internal UFS\n");
+        return EPERM;
+    }
+    printf("SWEET USBROOT: starting read-only USB disk, no internal UFS\n");
+    sweet_usb_probe();
+    err=sweet_usbroot_capacity(&sectors);
+    if(err){printf("SWEET USBROOT: capacity unavailable err=%d\n",err);return err;}
+    /* Up to 64 GiB, nonzero, full 512B sectors. Test-image guard. */
+    if(sectors<2048 || sectors>(64ull<<30)/UR_SECTOR_BYTES) return EINVAL;
+    urdisk.sectors=sectors;
+    urdisk.secsize=512;
+    urdisk.bmajor=bdevsw_add(-1,&ur_bdevsw);
+    if(urdisk.bmajor<0)return ENXIO;
+    urdisk.cmajor=cdevsw_add_with_bdev(-1,&ur_cdevsw,urdisk.bmajor);
+    if(urdisk.cmajor<0)return ENXIO;
+    urdisk.bdev=makedev(urdisk.bmajor,0);
+    devfs_make_node(urdisk.bdev,DEVFS_BLOCK,UID_ROOT,GID_OPERATOR,0440,"usbroot0");
+    devfs_make_node(makedev(urdisk.cmajor,0),DEVFS_CHAR,UID_ROOT,GID_OPERATOR,0440,"rusbroot0");
+    urdisk.ready=true;
+    *dev=urdisk.bdev;
+    printf("SWEET USBROOT: ready %llu sectors (%llu MiB), STRICTLY READ ONLY\n",
+        sectors,sectors/2048);
+    return 0;
+}
+#endif
