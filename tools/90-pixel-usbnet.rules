# Phone USB Ethernet (kernel patch 0075/0084, host MAC 02:00:5e:77:ee:01): give the host side 192.168.7.1/24 automatically.
# $name (the final name, e.g. enx02005e77ee01), not %k (the kernel name usb0/eth0: gone after udev's rename).
ACTION=="add|move", SUBSYSTEM=="net", ATTR{address}=="02:00:5e:77:ee:01", RUN+="/usr/sbin/ip addr replace 192.168.7.1/24 dev $name", RUN+="/usr/sbin/ip link set $name up"
