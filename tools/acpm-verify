#!/usr/bin/env python3
"""Offline checklist for the ACPM descriptor dump of `--touch-probe=railsr` (TP-008, docs/research/23). Reads DIR/usb.txt only.
  tools/acpm-verify --from-dir DIR [--expect-ch 2] [--sram-size 0x40000]
RESULT: PASS|FAIL|ERROR ...   exit 0 / 1 / 2.  Uses the LAST "ACPM cfg" block of usb.txt.
It re-derives every pointer/offset from the raw words and applies the shim's own sanity rules (shim/acpm.c acpm_describe).
It checks INTERNAL CONSISTENCY of the dump only; it cannot show the layout equals Google's firmware. It NEVER edits soc.json:
the human flips acpm.layout_verified / acpm.elem_unit_verified."""
import argparse, os, re, sys

H = lambda s: int(s, 16)


def parse(text):
    """-> dict of the last block: cfg, init[8], d[18], bufs{req,rsp}{off:[4 words]}, ptrs, raw refusal lines."""
    start = [i for i, l in enumerate(text) if "ACPM cfg mbox=" in l]
    blk = text[start[-1]:] if start else text
    r = {"init": {}, "d": {}, "buf": {"req": {}, "rsp": {}}, "refused": [], "ids": []}
    for l in blk:
        m = re.search(r"ACPM cfg mbox=(0x\w+) sram=(0x\w+)", l)
        if m: r["sram"] = H(m.group(2))
        m = re.search(r"ACPM cfg ch=(\d+) speedy=\d+ pmic=\d+ stride=(0x\w+)", l)
        if m: r["ch"], r["stride"] = int(m.group(1)), H(m.group(2))
        m = re.search(r"ACPM init\[(\d)\.\.\d\]=((?:[0-9a-f]{8} ?)+)", l)
        if m:
            for k, w in enumerate(m.group(2).split()): r["init"][int(m.group(1)) + k] = H(w)
        m = re.search(r"ACPM table n=(\d+) tab=\+(0x\w+) idx=(\d+)", l)
        if m: r["t_n"], r["t_tab"], r["t_idx"] = int(m.group(1)), H(m.group(2)), int(m.group(3))
        m = re.search(r"ACPM desc\[(\d+)\.\.\d+\]=((?:[0-9a-f]{8} ?)+)", l)
        if m:
            for k, w in enumerate(m.group(2).split()): r["d"][int(m.group(1)) + k] = H(w)
        m = re.search(r"ACPM (req|rsp) base@(0x\w+)", l)
        if m: r[m.group(1) + "_base"] = H(m.group(2))
        m = re.search(r"ACPM (req|rsp)\(\S+\) rear@(0x\w+)=(\d+) front@(0x\w+)=(\d+)", l)
        if m: r[m.group(1) + "_q"] = (H(m.group(2)), int(m.group(3)), H(m.group(4)), int(m.group(5)))
        m = re.search(r"ACPM q len=(\d+) elem=(\d+)", l)
        if m: r["p_qlen"], r["p_elem"] = int(m.group(1)), int(m.group(2))
        m = re.search(r"ACPM (req|rsp) buf\+([0-9a-f]+) ((?:[0-9a-f]{8} ?){4})", l)
        if m: r["buf"][m.group(1)][H(m.group(2))] = [H(w) for w in m.group(3).split()]
        if "ACPM describe refused" in l or "ACPM unsure" in l or "ACPM ids[" in l:
            r["refused"].append(l.strip()[-150:])
    return r


def check(r, ch, size):
    """-> (failure string | None, notes[]). Rules mirror shim/acpm.c acpm_describe + docs/research/23."""
    if r["refused"] and not r["d"]:
        return "the shim itself refused: " + " | ".join(r["refused"][:2]), []
    for k in ("sram", "stride"):
        if k not in r: return "no 'ACPM cfg' line (%s)" % k, []
    if len(r["init"]) < 8: return "init[0..7] incomplete", []
    if len(r["d"]) < 18: return "desc[0..17] incomplete (descriptor not dumped)", []
    sram, stride, i, d = r["sram"], r["stride"], r["init"], r["d"]
    n, tab = i[6], i[2]  # INIT_AP_MAX 0x18, INIT_CH_TAB 0x08
    if not 1 <= n <= 32: return "ipc_ap_max init[6]=%d not in 1..32" % n, []
    if stride < 0x48 or stride & 3 or tab & 3 or tab + n * stride > size:
        return "channel table +%#x x %d x stride %#x does not fit SRAM %#x" % (tab, n, stride, size), []
    if r.get("t_n") not in (None, n) or r.get("t_tab") not in (None, tab): return "printed table line disagrees with init words", []
    if d[0] != ch: return "desc id %d != expected channel %d" % (d[0], ch), []
    if r.get("t_idx", ch) != ch: return "table index %d is not the channel id %d" % (r["t_idx"], ch), []
    if d[3] != 1: return "desc type %d is not TYPE_QUEUE (1)" % d[3], []
    qlen, esz = d[13], d[14]
    if not 3 <= qlen <= 256: return "q_len %d not in 3..256" % qlen, []
    if esz != 16: return "q_elem_size %d: must be 16 BYTES (elem_unit 1)" % esz, []
    if "p_qlen" in r and (r["p_qlen"], r["p_elem"]) != (qlen, esz): return "printed q len/elem disagree with desc words", []
    spans = []
    for name, off in (("req rear", d[4]), ("req front", d[5]), ("rsp rear", d[10]), ("rsp front", d[11])):
        if off & 3 or off > size - 4: return "%s pointer %#x unaligned or outside SRAM" % (name, off), []
        spans.append((name, off, 4))
    for name, off in (("req buf", d[6]), ("rsp buf", d[12])):
        if off & 3 or off + qlen * 16 > size: return "%s %#x unaligned or outside SRAM" % (name, off), []
        spans.append((name, off, qlen * 16))
        if r.get(name[:3] + "_base") not in (None, sram + off): return "printed %s base disagrees with sram+desc word" % name, []
    for a in range(len(spans)):
        for b in range(a + 1, len(spans)):
            if spans[a][1] < spans[b][1] + spans[b][2] and spans[b][1] < spans[a][1] + spans[a][2]:
                return "%s overlaps %s" % (spans[a][0], spans[b][0]), []
    for q in ("req", "rsp"):
        if q + "_q" in r:
            _, rear, _, front = r[q + "_q"]
            if rear >= qlen or front >= qlen: return "%s index rear=%d front=%d >= q_len %d" % (q, rear, front, qlen), []
            if rear != front: return "%s queue not empty (rear %d front %d)" % (q, rear, front), []
    return None, ["ap_max=%d ch=%d q_len=%d elem=16B" % (n, ch, qlen)]


def slots_ok(r):
    """Request-buffer slots: non-empty ones look like commands at a 16-byte stride (bits 11:8 of word 0 == 1). -> (ok, nonempty count)"""
    b = r["buf"]["req"]
    if not b or any(o % 16 for o in b): return False, 0
    ne = [w for w in b.values() if w[0]]
    return bool(ne) and all((w[0] >> 8) & 0xf == 1 for w in ne), len(ne)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--from-dir", required=True)
    ap.add_argument("--expect-ch", type=int, default=2)
    ap.add_argument("--sram-size", type=lambda s: int(s, 0), default=0x40000)  # soc.json acpm.sram_size
    a = ap.parse_args()
    try:
        text = open(os.path.join(a.from_dir, "usb.txt"), errors="replace").read().splitlines()
    except OSError as e:
        print("RESULT: ERROR cannot read %s/usb.txt: %s" % (a.from_dir, e)); return 2
    if not any("ACPM init[" in l for l in text):
        print("RESULT: ERROR no ACPM descriptor lines in %s/usb.txt" % a.from_dir); return 2
    r = parse(text)
    bad, notes = check(r, a.expect_ch, a.sram_size)
    if bad:
        print("RESULT: FAIL %s (checked internal consistency only; set no flags)" % bad); return 1
    ok, ne = slots_ok(r)
    print("checked: %s" % notes[0])
    print("NOTE: internal consistency of this dump only, not proof the layout equals Google's firmware. soc.json is NOT edited.")
    if ok:
        print("RESULT: PASS layout consistent; you may set acpm.layout_verified=1 and acpm.elem_unit_verified=1 (%d request slots at 16 B stride)" % ne)
    else:
        print("RESULT: PASS layout consistent; set acpm.layout_verified=1 only (no non-empty 16 B request slots seen: elem_unit_verified stays 0)")
    return 0


sys.exit(main())
